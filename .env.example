# Public, build-time values only. Never put private keys or RPC credentials here.
# Copy to .env for local overrides; .env is ignored by git.

# Contract address of the VesperSigils registry, if you deployed one.
# Leave empty to run without on-chain minting.
VITE_SIGIL_CONTRACT=

# Chain the app expects: 8453 (Base mainnet) or 84532 (Base Sepolia).
VITE_CHAIN_ID=8453

# Public repository URL used by links in the app.
VITE_REPO_URL=https://github.com/YOUR-GITHUB-USERNAME/vesper

# Solana v0.2. Public values only; the app never reads a secret here.
# Cluster named in every sealed message. Defaults to devnet.
VITE_SOLANA_CLUSTER=devnet

# RPC endpoint used for mint and lookups.
VITE_SOLANA_RPC=https://api.devnet.solana.com

# Registry program id. Leave empty to seal without a chain target; the app
# then records the seal as a local, offline-verifiable attestation.
VITE_VESPER_PROGRAM=

# Never set DEPLOYER_PRIVATE_KEY or RPC URLs here. Pass them in the shell for
# contracts/scripts/deploy.ts and do not commit the shell history.
